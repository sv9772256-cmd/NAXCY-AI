{
  "name": "Python 3",
  "image": "://microsoft.com",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip install -r requirements.txt && if [ -f packages.txt ]; then sudo apt-get update && sudo apt-get install -y $(cat packages.txt); fi",
  "postAttachCommand": "streamlit run app.py --server.enableCORS=false --server.enableXsrfProtection=false",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  }
}
